rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role in ['admin', 'manager', 'supervisor', 'worker'] &&
        isValidTimestamp(data.createdAt);
    }

    function isValidWorker(data, userId) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.userId == userId &&
        data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 60 &&
        data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 60 &&
        (!('cin' in data) || (data.cin is string && data.cin.size() <= 20)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 60 &&
        data.startDateIso is string && data.startDateIso.size() == 10 &&
        data.isActive is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAttendanceEntry(data, userId) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.userId == userId &&
        data.workerId is string && data.workerId.size() >= 1 && data.workerId.size() <= 64 &&
        data.dateIso is string && data.dateIso.size() == 10 &&
        data.status in ['WORKED', 'ABSENT', 'REST_DAY', 'TO_FILL'] &&
        data.minutesWorked is int && data.minutesWorked >= 0 && data.minutesWorked <= 1440 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        (!('recordedBy' in data) || (data.recordedBy is string && data.recordedBy.size() <= 100)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidHourlyRateRecord(data, userId) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.userId == userId &&
        data.workerId is string && data.workerId.size() >= 1 && data.workerId.size() <= 64 &&
        data.effectiveDateIso is string && data.effectiveDateIso.size() == 10 &&
        data.hourlyRateMillimes is int && data.hourlyRateMillimes >= 0 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidAdvancePayment(data, userId) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.userId == userId &&
        data.workerId is string && data.workerId.size() >= 1 && data.workerId.size() <= 64 &&
        data.dateIso is string && data.dateIso.size() == 10 &&
        data.amountMillimes is int && data.amountMillimes >= 0 &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 300)) &&
        (!('recordedBy' in data) || (data.recordedBy is string && data.recordedBy.size() <= 100)) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidPayrollAdjustment(data, userId) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.userId == userId &&
        data.workerId is string && data.workerId.size() >= 1 && data.workerId.size() <= 64 &&
        data.monthIso is string && data.monthIso.size() == 7 &&
        data.type in ['BONUS', 'PENALTY', 'OVERTIME', 'OTHER'] &&
        data.amountMillimes is int && data.amountMillimes >= 0 &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 300)) &&
        (!('recordedBy' in data) || (data.recordedBy is string && data.recordedBy.size() <= 100)) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidSettledPayment(data, userId) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.userId == userId &&
        data.workerId is string && data.workerId.size() >= 1 && data.workerId.size() <= 64 &&
        data.monthIso is string && data.monthIso.size() == 7 &&
        data.amountMillimes is int && data.amountMillimes >= 0 &&
        data.paymentMethod in ['ESPECES', 'VIREMENT', 'CHEQUE'] &&
        data.paidBy is string && data.paidBy.size() >= 1 && data.paidBy.size() <= 100 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidAnnouncement(data, userId) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.isUrgent is bool &&
        isValidTimestamp(data.createdAt);
    }

    // --- Communication Rules Functions ---
    function isValidCompany(data, companyId) {
      return data.id == companyId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        (!('matriculeFiscal' in data) || (data.matriculeFiscal is string && data.matriculeFiscal.size() <= 50)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('standardDailyHours' in data) || (data.standardDailyHours is int && data.standardDailyHours >= 1 && data.standardDailyHours <= 24)) &&
        (!('referenceRateMillimes' in data) || (data.referenceRateMillimes is int && data.referenceRateMillimes >= 0)) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt)) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidCompanyMember(data, companyId, memberId) {
      return data.userId == memberId &&
        data.companyId == companyId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role in ['DIRECTRICE', 'CHAFE', 'OUVRIERE', 'admin', 'supervisor', 'worker'] &&
        data.status in ['ACTIVE', 'SUSPENDED'] &&
        data.canPostGroup is bool &&
        data.canDirectMessage is bool &&
        isValidTimestamp(data.createdAt);
    }

    function isValidChatConversation(data, conversationId, companyId) {
      return data.id == conversationId &&
        data.companyId == companyId &&
        data.type in ['GROUP', 'DIRECT'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidChatMessage(data, messageId, conversationId, companyId) {
      return data.id == messageId &&
        data.conversationId == conversationId &&
        data.companyId == companyId &&
        data.type in ['GROUP', 'DIRECT'] &&
        data.senderId == request.auth.uid &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
        data.senderRole in ['DIRECTRICE', 'CHAFE', 'OUVRIERE', 'admin', 'supervisor', 'worker'] &&
        (!('recipientId' in data) || (data.recipientId is string && data.recipientId.size() <= 128)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
        data.clientTimestamp is int && data.clientTimestamp > 0 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidWorkshopAnnouncement(data, announcementId, companyId) {
      return data.id == announcementId &&
        data.companyId == companyId &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.authorRole in ['DIRECTRICE', 'CHAFE', 'OUVRIERE'] &&
        data.type in ['INFORMATION', 'NOTIFICATION', 'SECURITE', 'ORGANISATION'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
        data.priority in ['NORMALE', 'IMPORTANTE', 'URGENTE'] &&
        data.targetAudience in ['TOUS', 'CHAFAS_ONLY', 'OUVRIERES_ONLY'] &&
        data.startEpochMs is int && data.startEpochMs > 0 &&
        data.endEpochMs is int && data.endEpochMs >= data.startEpochMs &&
        data.durationDays is int && data.durationDays >= 1 &&
        data.status in ['ACTIVE', 'EXPIRED', 'CANCELLED'] &&
        data.version is int && data.version >= 1 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAnnouncementReceipt(data, announcementId, companyId, userId) {
      return data.companyId == companyId &&
        data.announcementId == announcementId &&
        data.recipientUserId == userId &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 100 &&
        data.recipientRole in ['DIRECTRICE', 'CHAFE', 'OUVRIERE'] &&
        data.firstReadAtEpochMs is int && data.firstReadAtEpochMs > 0 &&
        data.lastReadAtEpochMs is int && data.lastReadAtEpochMs >= data.firstReadAtEpochMs &&
        data.announcementVersion is int && data.announcementVersion >= 1 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAuditEntry(data, companyId) {
      return data.companyId == companyId &&
        data.actorId == request.auth.uid &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100 &&
        data.timestampEpochMs is int &&
        isValidTimestamp(data.createdAt);
    }

    function isValidDeviceSession(data, companyId, sessionId) {
      return data.id == sessionId &&
        data.companyId == companyId &&
        data.userId is string && data.userId.size() >= 1 &&
        data.userName is string && data.userName.size() >= 1 &&
        data.deviceName is string && data.deviceName.size() >= 1 &&
        data.lastActiveEpochMs is int &&
        data.isRevoked is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidPermissions(data, companyId) {
      return data.companyId == companyId &&
        data.canEditPastAttendance is bool &&
        data.canRecordAdvances is bool &&
        data.canPublishAnnouncements is bool &&
        data.canViewPayrollFinancials is bool &&
        data.canManageWorkers is bool &&
        data.canViewAuditLogs is bool &&
        (!('canCloseArchive' in data) || data.canCloseArchive is bool) &&
        data.lastUpdatedEpochMs is int &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidMonthClosure(data, companyId, yearMonth) {
      return data.companyId == companyId &&
        data.yearMonth == yearMonth &&
        data.status in ['OUVERT', 'CLOTURE', 'EN_REVISION'] &&
        data.closedBy is string && data.closedBy.size() >= 1 && data.closedBy.size() <= 100 &&
        data.closedByRole in ['DIRECTRICE', 'CHAFE', 'OUVRIERE'] &&
        data.closedAtEpochMs is int &&
        data.revisionCount is int && data.revisionCount >= 0 &&
        (!('revisionReason' in data) || (data.revisionReason is string && data.revisionReason.size() <= 500)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        isValidTimestamp(data.updatedAt);
    }

    // --- Users Path ---
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /workers/{workerId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWorker(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /attendance/{attendanceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAttendanceEntry(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /rates/{rateId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidHourlyRateRecord(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /advances/{advanceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAdvancePayment(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /adjustments/{adjustmentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPayrollAdjustment(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSettledPayment(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /announcements/{announcementId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAnnouncement(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /memberships/{membershipId} {
        allow read: if isOwner(userId);
        allow create, update: if isAuthenticated();
        allow delete: if isOwner(userId);
      }

      match /join_requests/{requestId} {
        allow read: if isOwner(userId);
        allow create, update: if isAuthenticated();
        allow delete: if isOwner(userId);
      }
    }

    // --- Companies & Real Communication Isolation ---
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidCompany(request.resource.data, companyId);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isValidCompanyMember(request.resource.data, companyId, memberId);
        allow delete: if isAuthenticated() && request.auth.uid == memberId;
      }

      match /conversations/{conversationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isValidChatConversation(request.resource.data, conversationId, companyId);
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isAuthenticated() &&
            (resource.data.type == 'GROUP' ||
             resource.data.senderId == request.auth.uid ||
             resource.data.recipientId == request.auth.uid ||
             (('participantUids' in resource.data) && request.auth.uid in resource.data.participantUids));
          allow create, update: if isAuthenticated() &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.companyId == companyId &&
            isValidChatMessage(request.resource.data, messageId, conversationId, companyId);
          allow delete: if false;
        }
      }

      match /announcements/{announcementId} {
        allow read: if isAuthenticated() && resource.data.companyId == companyId;
        allow create: if isAuthenticated() &&
          request.resource.data.companyId == companyId &&
          request.resource.data.authorId == request.auth.uid &&
          isValidWorkshopAnnouncement(request.resource.data, announcementId, companyId);
        allow update: if isAuthenticated() &&
          request.resource.data.companyId == companyId &&
          (resource.data.authorId == request.auth.uid) &&
          isValidWorkshopAnnouncement(request.resource.data, announcementId, companyId);
        allow delete: if false;

        match /receipts/{userId} {
          allow read: if isAuthenticated() &&
            (request.auth.uid == userId ||
             request.auth.uid == get(/databases/$(database)/documents/companies/$(companyId)/announcements/$(announcementId)).data.authorId);
          allow create, update: if isAuthenticated() &&
            request.auth.uid == userId &&
            request.resource.data.companyId == companyId &&
            request.resource.data.announcementId == announcementId &&
            request.resource.data.recipientUserId == userId &&
            isValidAnnouncementReceipt(request.resource.data, announcementId, companyId, userId);
          allow delete: if false;
        }
      }

      match /audit_logs/{auditId} {
        allow read: if isAuthenticated() && resource.data.companyId == companyId;
        allow create: if isAuthenticated() &&
          request.resource.data.companyId == companyId &&
          request.resource.data.actorId == request.auth.uid &&
          isValidAuditEntry(request.resource.data, companyId);
        allow update, delete: if false;
      }

      match /sessions/{sessionId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
          request.resource.data.companyId == companyId &&
          isValidDeviceSession(request.resource.data, companyId, sessionId);
        allow delete: if false;
      }

      match /permissions/{permissionId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
          request.resource.data.companyId == companyId &&
          isValidPermissions(request.resource.data, companyId);
        allow delete: if false;
      }

      match /month_closures/{yearMonth} {
        allow read: if isAuthenticated() && resource.data.companyId == companyId;
        allow create, update: if isAuthenticated() &&
          request.resource.data.companyId == companyId &&
          isValidMonthClosure(request.resource.data, companyId, yearMonth);
        allow delete: if false;
      }

      match /join_requests/{requestId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if false;
      }
    }
  }
}

